rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // This app never talks to Firestore directly from the client — every
    // read/write goes through the Vercel proxy (multi-lingo-ai-api) using
    // the Firebase Admin SDK, which always bypasses these rules regardless
    // of what they say. Deny everything here so a leaked client config, an
    // accidental future client-SDK import, or a project still sitting in
    // Firebase's default "test mode" can't expose data directly.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
